---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site } from '../data/site';
import { cv } from '../data/cv';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---
<BaseLayout title={`${t('cv.title')} — ${site.name}`}>
  <div class="container" style="padding-block: var(--space-6);">
    <h1>{t('cv.title')}</h1>
    <hr class="rule" />
    <section>
      <SectionHeader title={t('cv.education')} />
      <ul class="cv-list">
        {cv.education.en.map((e) => (
          <li><span class="label">{e.period}</span> {e.role}{e.org ? `, ${e.org}` : ''}</li>
        ))}
      </ul>
    </section>
    <section>
      <SectionHeader title={t('cv.positions')} />
      <ul class="cv-list">
        {cv.positions.en.map((e) => (
          <li><span class="label">{e.period}</span> {e.role}{e.org ? `, ${e.org}` : ''}</li>
        ))}
      </ul>
    </section>
    <section>
      <SectionHeader title={t('cv.awards')} />
      <ul class="cv-list">{cv.awards.en.map((a) => <li>{a}</li>)}</ul>
    </section>
    <section>
      <SectionHeader title={t('cv.service')} />
      <ul class="cv-list">{cv.service.en.map((s) => <li>{s}</li>)}</ul>
    </section>
  </div>
</BaseLayout>
