---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { site } from '../../data/site';
import { researchAreas } from '../../data/researchAreas';
import { useTranslations } from '../../i18n/utils';

const lang = 'zh';
const t = useTranslations(lang);
const areas = [...researchAreas].sort((a, b) => a.order - b.order);
---
<BaseLayout title={`${site.name} — ${site.employer}`} description={t('home.intro')}>
  <section class="home-hero container">
    <h1>{site.name}</h1>
    <p class="home-hero__role">{t('home.role')}</p>
    <p class="home-hero__intro">{t('home.intro')}</p>
  </section>

  <section class="home-section container" id="research">
    <SectionHeader number="01" title={t('home.researchHeading')} intro={t('home.researchIntro')} />
    <ul class="research-list">
      {areas.map((area) => (
        <li class="research-item" style={`border-color:${area.color}`}>
          <span class="research-item__num">{String(area.order).padStart(2, '0')}</span>
          <div class="research-item__label">{area.label.zh}</div>
          <p class="research-item__desc">{area.desc.zh}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
